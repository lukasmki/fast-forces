{
    "name" : "Water",
    "description": "Bulk water proton transfer: the Zundel and hydroxide hops plus autoionization, computed at wb97x-v/aug-cc-pvtz",
    "version" : "1.0.0",
    "author": "Lukas Kim",
    "molecules": [
        {"id" : 1, "smiles": "[H]",    "path": "molecules/h"},
        {"id" : 2, "smiles": "[O]",    "path": "molecules/o"},
        {"id" : 3, "smiles": "[OH-]",  "path": "molecules/h1o"},
        {"id" : 4, "smiles": "O",      "path": "molecules/h2o"},
        {"id" : 5, "smiles": "[OH3+]", "path": "molecules/h3o"}
    ],
    "reactions": [
        {"id": 1, "smiles": "[OH3+].O>>O.[OH3+]",    "path" : "reactions/h3o-h2o-transfer"},
        {"id": 2, "smiles": "O.[OH-]>>[OH-].O",      "path" : "reactions/h2o-oh-transfer"},
        {"id": 3, "smiles": "O.O>>[OH-].[OH3+]",     "path" : "reactions/h2o-autoionization"}
    ],
    "global_params": {
        "bond_asymptote": 1.0,
        "taper_radius": 1.5,
        "taper_width": 0.12,
        "switch_radius": 0.22,
        "core_fraction": 0.4,
        "exclusion_depth": 3,
        "exclude_coulomb": true,
        "gamma": 2.0
    },
    "fit_config": {
        "calculator": {
            "name": "pyscf",
            "xc": "HYB_GGA_XC_WB97X_V",
            "basis": "aug-cc-pvtz",
            "pcm": "IEF-PCM",
            "pcm_eps": 78.3553
        },
        "workdir": "training",
        "n_mode_frames": 40,
        "n_conformers": 0,
        "temperature": 500.0
    }
}
